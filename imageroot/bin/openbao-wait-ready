#
# Wait until the OpenBao API answers, then log its seal state. It runs as
# ExecStartPost of openbao.service.
#

import sys
import time
import openbao

timeout = int(sys.argv[1]) if len(sys.argv) > 1 else 60
deadline = time.monotonic() + timeout

while True:
    status = openbao.get_seal_status(timeout=2)
    if status is not None:
        break
    if time.monotonic() > deadline:
        print(f"<4>OpenBao API is not answering after {timeout} seconds", file=sys.stderr)
        sys.exit(1)
    time.sleep(1)

if not status.get("initialized"):
    print("<5>OpenBao is not initialized: open its web UI to initialize it", file=sys.stderr)
elif status.get("sealed"):
    print("<5>OpenBao is sealed: provide the unseal keys from its web UI or CLI", file=sys.stderr)
else:
    print(f"OpenBao {status.get('version', '')} is unsealed and ready", file=sys.stderr)
