#!/usr/bin/env python3

#
# Copyright (C) 2026 Genius Dynamics
# SPDX-License-Identifier: GPL-3.0-or-later
#

#
# Change the unseal mode of an initialized OpenBao (seal migration). The
# unseal mode is written in the storage at initialization, so this is the
# only supported way to change it afterwards. Run it on the node:
#
#   runagent -m openbao1 openbao-seal-migrate start auto
#   runagent -m openbao1 openbao-seal-migrate start transit \
#       --transit-address https://kms.example.org:8200 --transit-key ns8 [--transit-mount transit]
#   runagent -m openbao1 openbao-seal-migrate start manual
#   runagent -m openbao1 openbao-seal-migrate status
#   runagent -m openbao1 openbao-seal-migrate finish
#   runagent -m openbao1 openbao-seal-migrate abort
#
# "start" takes a safety copy of the storage, configures the new seal next
# to the previous one (disabled) and restarts OpenBao. The operator then
# runs, from any computer with the bao client:
#
#   bao operator unseal -migrate
#
# once per key, until the threshold: the unseal keys when leaving manual
# unseal, the recovery keys when leaving automatic or Transit unseal. The
# keys go straight to OpenBao: this module never sees them. "finish" then
# removes the previous seal from the configuration.
#
# For a Transit target, store its token first: openbao-transit-token.
#

import argparse
import os
import subprocess
import sys
import time
import openbao

os.environ.setdefault("AGENT_STATE_DIR", os.getcwd())
import agent  # noqa: E402

parser = argparse.ArgumentParser(prog="openbao-seal-migrate")
parser.add_argument("action", choices=["start", "status", "finish", "abort"])
parser.add_argument("target", nargs="?", choices=openbao.UNSEAL_MODES)
parser.add_argument("--transit-address")
parser.add_argument("--transit-key")
parser.add_argument("--transit-mount")
parser.add_argument("--transit-tls-skip-verify", action="store_true")
args = parser.parse_args()

env = openbao.read_environment()
current = env["OPENBAO_UNSEAL_MODE"]
migrate_from = env["OPENBAO_SEAL_MIGRATION_FROM"]
host = env.get("TRAEFIK_HOST", "")


def restart():
    subprocess.run(["systemctl", "--user", "restart", "openbao.service"], check=True)


def key_kind(mode):
    return "unseal keys" if mode == "manual" else "recovery keys"


status = openbao.get_seal_status()

if args.action == "status":
    if not migrate_from:
        print(f"No seal migration in progress. Unseal mode: {current}")
    else:
        print(f"Seal migration from {migrate_from} to {current}")
        if status:
            print(f"OpenBao: sealed={status.get('sealed')} migration={status.get('migration', False)} "
                  f"progress={status.get('progress')}/{status.get('t')}")
    sys.exit(0)

if args.action == "start":
    if migrate_from:
        sys.exit(f"A migration from {migrate_from} to {current} is in progress: finish or abort it")
    target = args.target
    if not target or target == current:
        sys.exit(f"Choose a target unseal mode different from the current one ({current})")
    if not status or not status.get("initialized") or status.get("sealed"):
        sys.exit("OpenBao must be running, initialized and unsealed")
    if target == "transit":
        address = args.transit_address or env["OPENBAO_TRANSIT_ADDRESS"]
        key = args.transit_key or env["OPENBAO_TRANSIT_KEY"]
        if not address or not key:
            sys.exit("Give --transit-address and --transit-key")
        if not os.path.exists(openbao.TRANSIT_TOKEN_FILE):
            sys.exit("Store the Transit token first: openbao-transit-token")
        agent.set_env("OPENBAO_TRANSIT_ADDRESS", address)
        agent.set_env("OPENBAO_TRANSIT_KEY", key)
        if args.transit_mount:
            agent.set_env("OPENBAO_TRANSIT_MOUNT", args.transit_mount)
        agent.set_env("OPENBAO_TRANSIT_TLS_SKIP_VERIFY", str(args.transit_tls_skip_verify))

    # Safety copy of the storage, taken with OpenBao stopped
    stamp = time.strftime("%Y%m%d-%H%M%S")
    backup = f"openbao-premigration-{stamp}.tar"
    mountpoint = subprocess.run(["podman", "volume", "inspect", "--format", "{{.Mountpoint}}",
                                 openbao.DATA_VOLUME], capture_output=True, text=True,
                                check=True).stdout.strip()
    subprocess.run(["systemctl", "--user", "stop", "openbao.service"], check=True)
    try:
        subprocess.run(["podman", "unshare", "tar", "--numeric-owner", "-C", mountpoint,
                        "-cpf", backup, "."], check=True)
        os.chmod(backup, 0o600)
    except subprocess.CalledProcessError:
        subprocess.run(["systemctl", "--user", "start", "openbao.service"], check=False)
        sys.exit("Cannot copy the storage: nothing was changed")

    agent.set_env("OPENBAO_SEAL_MIGRATION_FROM", current)
    agent.set_env("OPENBAO_UNSEAL_MODE", target)
    subprocess.run(["systemctl", "--user", "start", "openbao.service"], check=True)
    print(f"Storage copied to {backup} (state directory).")
    print(f"OpenBao restarted for the migration from {current} to {target}. Now run, once")
    print(f"per key until the threshold, with the {key_kind(current)}:\n")
    print(f"  export BAO_ADDR=https://{host}" if host else "  export BAO_ADDR=<OpenBao URL>")
    print("  bao operator unseal -migrate\n")
    print("Then: runagent -m <module> openbao-seal-migrate finish")
    sys.exit(0)

if not migrate_from:
    sys.exit("No seal migration in progress")

if args.action == "abort":
    if status and status.get("initialized") and not status.get("sealed") and not status.get("migration"):
        sys.exit("The migration has already been applied by OpenBao: run finish instead")
    agent.set_env("OPENBAO_UNSEAL_MODE", migrate_from)
    agent.unset_env("OPENBAO_SEAL_MIGRATION_FROM")
    restart()
    print(f"Migration aborted: unseal mode {migrate_from} restored")
    sys.exit(0)

# finish
if not status or status.get("sealed") or status.get("migration"):
    sys.exit("OpenBao has not completed the migration yet: provide the keys with "
             "'bao operator unseal -migrate' first")
agent.unset_env("OPENBAO_SEAL_MIGRATION_FROM")
restart()
new_kind = "unseal keys" if current == "manual" else "recovery keys"
print(f"Seal migration to {current} completed. The previous keys are now your {new_kind}.")
if current == "manual":
    print("OpenBao restarted sealed: unseal it with those keys.")
print("Keep the safety copy (openbao-premigration-*.tar) until a new backup has run, then delete it.")
