#!/usr/bin/env python3

#
# Copyright (C) 2026 Genius Dynamics
# SPDX-License-Identifier: GPL-3.0-or-later
#

#
# Initialize OpenBao from the node and print its first credentials in the
# terminal, where they stay until you copy them:
#
#   runagent -m openbao1 openbao-init                      # 5 shares, threshold 3
#   runagent -m openbao1 openbao-init --shares 3 --threshold 2
#
# - Manual unseal: prints the unseal keys and the root token, then unseals
#   OpenBao with them, so it is ready to use.
# - Automatic or Transit unseal: prints the recovery keys and the root
#   token; OpenBao unseals itself.
#
# The keys and the token are printed on standard output only: they are
# never written to disk, logged, or passed through NethServer actions.
#

import argparse
import sys
import urllib.error
import openbao

parser = argparse.ArgumentParser(description="Initialize OpenBao and print its first credentials")
parser.add_argument("--shares", type=int, default=5, help="number of key shares (default 5)")
parser.add_argument("--threshold", type=int, default=3, help="shares needed to unseal or recover (default 3)")
args = parser.parse_args()
if not 1 <= args.threshold <= args.shares <= 10:
    sys.exit("Use 1 <= threshold <= shares <= 10")

env = openbao.read_environment()
status = openbao.get_seal_status()
if status is None:
    sys.exit("OpenBao is not answering: configure the application and start it first")
if status.get("initialized"):
    sys.exit("OpenBao is already initialized")
if openbao.auto_initialize_wanted(env):
    sys.exit("Automatic initialization is configured: OpenBao initializes itself, nothing to do")

auto = env["OPENBAO_UNSEAL_MODE"] in ("auto", "transit")
if auto:
    request = {"recovery_shares": args.shares, "recovery_threshold": args.threshold}
else:
    request = {"secret_shares": args.shares, "secret_threshold": args.threshold}

try:
    result = openbao.api_request("sys/init", method="PUT", data=request, timeout=60)
except urllib.error.HTTPError as ex:
    sys.exit(f"Initialization failed: HTTP {ex.code} {ex.read().decode(errors='replace')}")

keys = result.get("recovery_keys" if auto else "keys", [])
kind = "Recovery key" if auto else "Unseal key"
print()
print("=" * 72)
print("OpenBao is initialized. Copy the following NOW and store each key and")
print("the root token in a different safe place. They are not shown again and")
print("are not stored anywhere by NethServer.")
print("=" * 72)
print()
for index, key in enumerate(keys, start=1):
    print(f"{kind} {index}: {key}")
print()
print(f"Root token: {result.get('root_token', '')}")
print()
if auto:
    print(f"{args.threshold} of the {args.shares} recovery keys are needed to generate a new root")
    print("token or to change the seal. OpenBao unseals itself.")
else:
    print(f"{args.threshold} of the {args.shares} unseal keys are needed after every restart.")
    for key in keys[:args.threshold]:
        openbao.api_request("sys/unseal", method="PUT", data={"key": key}, timeout=30)
    after = openbao.get_seal_status() or {}
    print("OpenBao is now unsealed." if not after.get("sealed") else
          "OpenBao is still sealed: unseal it with the keys above.")
print()
if env["OPENBAO_USER_DOMAIN"]:
    print("Next: enable directory login with 'runagent -m <instance> openbao-apply-config'")
    print("(paste the root token when asked), check that an administrator can log in,")
    print("then revoke the root token.")
else:
    print("Next: sign in with the root token, create administrator access, then")
    print("revoke the root token.")
