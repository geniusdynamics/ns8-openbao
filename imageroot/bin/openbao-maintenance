#
# Daily maintenance, run by openbao-maintenance.timer: renew the periodic
# module token so it never expires, and take the scheduled snapshot.
#

import os
import sys
import time
import urllib.error
import openbao

token = openbao.read_module_token()
status = openbao.get_seal_status()
if not token or not status or status.get("sealed"):
    sys.exit(0)  # nothing to do, or retried at the next run
try:
    openbao.api_request("auth/token/renew-self", method="POST", data={}, token=token)
    print("Module token renewed", file=sys.stderr)
except urllib.error.HTTPError as ex:
    print(f"<4>Cannot renew the module token: HTTP {ex.code}", file=sys.stderr)
except (urllib.error.URLError, OSError) as ex:
    print(f"<4>Cannot renew the module token: {ex}", file=sys.stderr)

# Scheduled local snapshots, keeping the newest OPENBAO_SNAPSHOT_KEEP
keep = openbao.snapshot_keep(openbao.read_environment())
if keep > 0:
    os.makedirs(openbao.SNAPSHOT_DIR, mode=0o700, exist_ok=True)
    name = time.strftime("openbao-%Y%m%d-%H%M%S.snap", time.gmtime())
    if openbao.save_snapshot(os.path.join(openbao.SNAPSHOT_DIR, name)):
        print(f"Snapshot {name} saved", file=sys.stderr)
    for old in openbao.list_snapshots()[keep:]:
        os.unlink(os.path.join(openbao.SNAPSHOT_DIR, old["name"]))
        print(f"Snapshot {old['name']} removed", file=sys.stderr)
