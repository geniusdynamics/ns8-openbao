#
# Generate the OpenBao server configuration from the module environment.
# It runs as ExecStartPre of openbao.service, so the configuration is always
# consistent with the environment after updates, restores and clones.
#

import sys
import openbao

try:
    # The server is about to start: it loads exactly this configuration
    openbao.mark_applied(openbao.write_config())
except Exception as ex:
    print(f"<3>Cannot write the OpenBao configuration: {ex}", file=sys.stderr)
    sys.exit(1)

print("OpenBao configuration written", file=sys.stderr)
