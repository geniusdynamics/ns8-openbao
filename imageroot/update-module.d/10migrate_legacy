#
# Migrate instances created by releases before 1.0.0. They ran OpenBao in
# development mode inside a pod (openbao.service + openbao-app.service):
# the dev server keeps everything in memory, so there is no data to move.
# Remove the old pod, so the new single-container service can bind the
# same TCP port.
#

exec 1>&2

if podman pod exists openbao; then
    echo "Removing the legacy OpenBao pod (development mode, no persistent data)"
    systemctl --user stop openbao-app.service || :
    podman pod rm --force --ignore openbao || :
fi

# Files of the legacy release. Missing OPENBAO_* settings fall back to
# their defaults (manual unseal).
rm -f openbao.env smarthost.env smarthost.env.tmp

exit 0
