#
# A cluster VPN change happened. If the VPN address of this node changed,
# publish the metrics and cluster API listeners on the new address and
# update the Prometheus target and the service provider record. Restart
# OpenBao only in that case: with manual unseal a restart seals it.
#

import subprocess
import sys
import openbao

expected = openbao.render_config(openbao.read_environment())["runtime_env_text"]
try:
    with open(openbao.RUNTIME_ENV_FILE, encoding="utf-8") as rfile:
        current = rfile.read()
except FileNotFoundError:
    sys.exit(0)  # never started

if current == expected:
    sys.exit(0)

print("<5>Cluster network endpoints changed: restarting OpenBao", file=sys.stderr)
env = openbao.read_environment()
if openbao.ha_role(env) != "standalone":
    # The Raft data still holds the previous address of this node: the
    # other members cannot reach it until it is updated (see
    # docs/high-availability.md, "Changing a member address").
    print(f"<4>High availability: the Raft address of node {openbao.raft_node_id(env)} "
          f"is now {openbao.raft_address(env)}: update it in the Raft cluster", file=sys.stderr)
subprocess.run(["systemctl", "--user", "try-restart", "openbao.service"], check=False)
subprocess.run(["openbao-publish-metrics-target"], check=False)
subprocess.run(["openbao-publish-service"], check=False)
