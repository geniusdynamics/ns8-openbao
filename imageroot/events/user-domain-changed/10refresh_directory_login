#
# The settings of a user domain changed. OpenBao keeps its own copy of the
# LDAP connection settings, written when directory login was configured.
#

import json
import os
import subprocess
import sys
import openbao

event = json.load(sys.stdin)
env = openbao.read_environment()
domain = env["OPENBAO_USER_DOMAIN"]

if not domain or domain not in event.get("domains", []):
    sys.exit(0)

status = openbao.get_seal_status()
if status is not None and not status.get("initialized"):
    # Self-initialization is pending: regenerate it with fresh settings
    if openbao.auto_initialize_wanted(env):
        subprocess.run(["systemctl", "--user", "try-restart", "openbao.service"], check=False)
    sys.exit(0)

message = (
    f"The settings of user domain {domain} changed. If its bind credentials "
    "or servers changed, update the OpenBao directory login by running on the node:\n\n"
    f"  runagent -m {os.environ.get('MODULE_ID', '<module>')} openbao-setup-ldap\n"
)
print("<4>" + message.replace("\n", " "), file=sys.stderr)
openbao.send_notification(env, f"user domain {domain} changed", message)
