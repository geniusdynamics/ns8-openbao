{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "provision-client output",
    "$id": "http://schema.nethserver.org/openbao/provision-client-output.json",
    "description": "A wrapped OpenBao token and how to use it. The wrapping tokens are single use and expire after wrap_ttl seconds",
    "examples": [
        {
            "module_id": "postgresql19c1",
            "openbao_module_id": "openbao1",
            "address": "http://10.5.4.1:20003",
            "address_type": "vpn",
            "wrapped_token": "s.WRAPPINGTOKEN",
            "wrap_ttl": 120,
            "wrap_creation_path": "auth/token/create/ns8-client",
            "token_role": "ns8-client",
            "token_policies": [
                "default",
                "ns8-client-kv"
            ],
            "token_period": 86400,
            "token_explicit_max_ttl": 2592000,
            "kv_mount": "ns8-kv",
            "kv_version": 2,
            "kv_prefix": "modules/postgresql19c1",
            "database_engine": false,
            "database_mount": "",
            "groups": []
        }
    ],
    "type": "object",
    "required": [
        "module_id",
        "address",
        "wrapped_token",
        "wrap_ttl",
        "wrap_creation_path",
        "kv_mount",
        "kv_prefix",
        "database_engine",
        "database_mount",
        "groups"
    ],
    "properties": {
        "module_id": {
            "type": "string"
        },
        "openbao_module_id": {
            "type": "string"
        },
        "address": {
            "type": "string",
            "description": "OpenBao API base URL for the client"
        },
        "address_type": {
            "type": "string",
            "enum": [
                "vpn",
                "public"
            ]
        },
        "wrapped_token": {
            "type": "string",
            "description": "Response-wrapping token: POST it to sys/wrapping/unwrap within wrap_ttl seconds"
        },
        "wrap_ttl": {
            "type": "integer"
        },
        "wrap_creation_path": {
            "type": "string",
            "description": "Expected creation_path of the wrapping token (check it with sys/wrapping/lookup)"
        },
        "token_role": {
            "type": "string"
        },
        "token_policies": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "token_period": {
            "type": "integer",
            "description": "Seconds: renew the token (auth/token/renew-self) before it elapses"
        },
        "token_explicit_max_ttl": {
            "type": "integer",
            "description": "Seconds: the token cannot live longer; provision again before"
        },
        "kv_mount": {
            "type": "string"
        },
        "kv_version": {
            "type": "integer"
        },
        "kv_prefix": {
            "type": "string"
        },
        "database_engine": {
            "type": "boolean"
        },
        "database_mount": {
            "type": "string"
        },
        "groups": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "group_id",
                    "kv_prefix",
                    "wrapped_token",
                    "wrap_ttl",
                    "token_policies"
                ],
                "properties": {
                    "group_id": {
                        "type": "string",
                        "maxLength": 64,
                        "pattern": "^[a-z][a-z0-9-]{0,62}[a-z]$"
                    },
                    "kv_prefix": {
                        "type": "string"
                    },
                    "wrapped_token": {
                        "type": "string",
                        "description": "Response-wrapping token of the group token: single use, unwrap at once"
                    },
                    "wrap_ttl": {
                        "type": "integer"
                    },
                    "token_policies": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}
