import json
import os
import sys
import agent
import openbao

request = json.load(sys.stdin)

if not openbao.public_access(openbao.read_environment()):
    # Cluster network only: remove the public route, if any
    response = agent.tasks.run(
        agent_id=agent.resolve_agent_id("traefik@node"),
        action="delete-route",
        data={"instance": os.environ["MODULE_ID"]},
        extra={"isNotificationHidden": True},
    )
    if response["exit_code"] != 0:
        print(agent.SD_WARNING + "No public route to remove", file=sys.stderr)
    sys.exit(0)

# The route "instance" starts with MODULE_ID: it is removed automatically
# when the module is removed.
route = {
    "instance": os.environ["MODULE_ID"],
    "url": "http://127.0.0.1:" + os.environ["TCP_PORT"],
    "host": request["host"],
    "http2https": request.get("http2https", True),
    "lets_encrypt_check": True,
    "lets_encrypt_cleanup": True,
}
# Always send the list: an empty list removes a previous restriction
route["ip_allowlist"] = openbao.ip_allowlist(openbao.read_environment())
if "lets_encrypt" in request:
    route["lets_encrypt"] = request["lets_encrypt"]

# On failure set_route() aborts this action, passing through the Traefik
# validation errors (e.g. Let's Encrypt challenge failures).
agent.set_route(route)
