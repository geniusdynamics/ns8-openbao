import ipaddress
import json
import os
import sys
import agent
import openbao

request = json.load(sys.stdin)
env = openbao.read_environment()


def set_bool(var, field):
    value = request[field] if field in request else openbao.is_true(env[var])
    agent.set_env(var, str(bool(value)))


agent.set_env("TRAEFIK_HOST", request["host"])
agent.set_env("TRAEFIK_HTTP2HTTPS", str(bool(request.get("http2https", True))))
agent.set_env("OPENBAO_LOG_LEVEL", request.get("log_level", env["OPENBAO_LOG_LEVEL"]))
set_bool("OPENBAO_AUDIT_LOG", "audit_log")
agent.set_env("OPENBAO_UNSEAL_MODE", request.get("unseal_mode", env["OPENBAO_UNSEAL_MODE"]))

user_domain = request.get("user_domain", env["OPENBAO_USER_DOMAIN"])
agent.set_env("OPENBAO_USER_DOMAIN", user_domain)
admin_group = request.get("ldap_admin_group", env["OPENBAO_LDAP_ADMIN_GROUP"]).strip()
agent.set_env("OPENBAO_LDAP_ADMIN_GROUP", admin_group if user_domain else "")

# Self-initialization only matters before OpenBao is initialized: drop the
# flag afterwards, so the bind password is no longer passed to the server.
auto_initialize = request.get("auto_initialize", openbao.is_true(env["OPENBAO_AUTO_INITIALIZE"]))
if auto_initialize and openbao.storage_state() == "initialized":
    print("OpenBao is already initialized: automatic initialization is ignored", file=sys.stderr)
    auto_initialize = False
agent.set_env("OPENBAO_AUTO_INITIALIZE", str(bool(auto_initialize)))

if "ip_allowlist" in request:
    agent.set_env("OPENBAO_IP_ALLOWLIST", ",".join(
        str(ipaddress.ip_network(n, strict=False)) for n in request["ip_allowlist"]))
if "ldap_group_policies" in request:
    agent.set_env("OPENBAO_LDAP_GROUP_POLICIES",
                  openbao.encode_group_policies(request["ldap_group_policies"]))
if "starter_kits" in request:
    agent.set_env("OPENBAO_STARTER_KITS", ",".join(request["starter_kits"]))

set_bool("OPENBAO_VPN_API", "vpn_api")
set_bool("OPENBAO_PUBLIC_ACCESS", "public_access")
if "snapshot_keep" in request:
    agent.set_env("OPENBAO_SNAPSHOT_KEEP", str(request["snapshot_keep"]))
for field, var in [
        ("transit_address", "OPENBAO_TRANSIT_ADDRESS"),
        ("transit_mount", "OPENBAO_TRANSIT_MOUNT"),
        ("transit_key", "OPENBAO_TRANSIT_KEY"),
    ]:
    if field in request:
        agent.set_env(var, request[field])
set_bool("OPENBAO_TRANSIT_TLS_SKIP_VERIFY", "transit_tls_skip_verify")

# High availability (experimental), validated by 01validate
previous_role = openbao.ha_role(env)
role = request.get("ha_role", previous_role)
agent.set_env("OPENBAO_HA_ROLE", role)
if role == "primary":
    # Members join through the cluster network API
    agent.set_env("OPENBAO_VPN_API", "True")
    if previous_role != "primary" or not env["OPENBAO_HA_CLUSTER"]:
        agent.set_env("OPENBAO_HA_CLUSTER", os.environ["MODULE_ID"])
    agent.set_env("OPENBAO_HA_JOIN", "")
    agent.set_env("OPENBAO_HA_JOIN_ADDRS", "")
    if previous_role == "standalone" and openbao.storage_state() == "initialized":
        # Move this node's Raft entry from loopback to the VPN address
        agent.set_env("OPENBAO_RAFT_RECOVER", "True")
elif role == "member":
    join = request.get("ha_join", env["OPENBAO_HA_JOIN"])
    instances = openbao.list_cluster_instances()
    target = next(i for i in instances if i["module_id"] == join)
    addresses = [target["api_url"]] + [
        i["api_url"] for i in instances
        if i["ha_cluster"] == target["ha_cluster"] and i["api_url"] and i is not target]
    agent.set_env("OPENBAO_HA_JOIN", join)
    agent.set_env("OPENBAO_HA_CLUSTER", target["ha_cluster"])
    agent.set_env("OPENBAO_HA_JOIN_ADDRS", ",".join(addresses))
    if previous_role != "member" or not env["OPENBAO_RAFT_NODE_ID"]:
        agent.set_env("OPENBAO_RAFT_NODE_ID", os.environ["MODULE_ID"])
    # Same seal as the cluster; a member never initializes itself
    agent.set_env("OPENBAO_UNSEAL_MODE", target["unseal_mode"])
    if target["unseal_mode"] == "transit":
        agent.set_env("OPENBAO_TRANSIT_ADDRESS", target["transit_address"])
        agent.set_env("OPENBAO_TRANSIT_MOUNT", target["transit_mount"])
        agent.set_env("OPENBAO_TRANSIT_KEY", target["transit_key"])
        agent.set_env("OPENBAO_TRANSIT_TLS_SKIP_VERIFY", str(target["transit_tls_skip_verify"]))
    agent.set_env("OPENBAO_AUTO_INITIALIZE", "False")
else:
    if previous_role == "primary" and openbao.storage_state() == "initialized":
        # Move this node's Raft entry back to loopback (no members left)
        agent.set_env("OPENBAO_RAFT_RECOVER", "True")
    if previous_role == "member":
        # Never joined (validated): forget the member node ID
        agent.set_env("OPENBAO_RAFT_NODE_ID", "")
    for var in ["OPENBAO_HA_CLUSTER", "OPENBAO_HA_JOIN", "OPENBAO_HA_JOIN_ADDRS"]:
        agent.set_env(var, "")

if "notify_recipients" in request:
    agent.set_env("OPENBAO_NOTIFY_RECIPIENTS", ",".join(request["notify_recipients"]))

# Settings of previous module releases, no longer used
for var in ["TRAEFIK_LETS_ENCRYPT"]:
    if var in os.environ:
        agent.unset_env(var)
