#
# Apply the configuration. A restart is done only when OpenBao cannot
# reload the changed settings: with manual unseal a restart seals the
# server, so avoid it whenever possible.
#

import sys
import agent
import openbao


def systemctl(*args):
    agent.run_helper("systemctl", "--user", *args).check_returncode()


# Enabled catalog plugins whose image is missing, for example after a
# restore, a clone or a module update that pins a new version
openbao.pull_plugin_images(openbao.enabled_plugins(openbao.read_environment()))
openbao.install_plugins()
record = openbao.write_config()
status = openbao.get_seal_status()
change = openbao.required_change(record, initialized=bool(status and status.get("initialized")))

systemctl("enable", "openbao.service")

if not openbao.service_is_active():
    print("Starting OpenBao", file=sys.stderr)
    systemctl("start", "openbao.service")
elif change == "restart":
    print("Restarting OpenBao to apply the new configuration", file=sys.stderr)
    systemctl("restart", "openbao.service")
elif change == "reload":
    print("Reloading the OpenBao configuration", file=sys.stderr)
    systemctl("reload", "openbao.service")
    openbao.mark_applied(record)
else:
    print("OpenBao configuration is unchanged", file=sys.stderr)

# Daily renewal of the module token
systemctl("enable", "--now", "openbao-maintenance.timer")

# Email notifications through the cluster smarthost
if openbao.notify_recipients(openbao.read_environment()):
    systemctl("enable", "--now", "openbao-notify.timer")
else:
    systemctl("disable", "--now", "openbao-notify.timer")
