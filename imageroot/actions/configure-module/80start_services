#
# Apply the configuration. A restart is done only when OpenBao cannot
# reload the changed settings: with manual unseal a restart seals the
# server, so avoid it whenever possible.
#

import sys
import agent
import openbao

record = openbao.write_config()
change = openbao.required_change(record)

agent.run_helper("systemctl", "--user", "enable", "openbao.service").check_returncode()

if not openbao.service_is_active():
    print("Starting OpenBao", file=sys.stderr)
    agent.run_helper("systemctl", "--user", "start", "openbao.service").check_returncode()
elif change == "restart":
    print("Restarting OpenBao to apply the new configuration", file=sys.stderr)
    agent.run_helper("systemctl", "--user", "restart", "openbao.service").check_returncode()
elif change == "reload":
    print("Reloading the OpenBao configuration", file=sys.stderr)
    agent.run_helper("systemctl", "--user", "reload", "openbao.service").check_returncode()
    openbao.mark_applied(record)
else:
    print("OpenBao configuration is unchanged", file=sys.stderr)
