import agent
import openbao

# Non-secret defaults. The unseal mode is chosen on the first
# configure-module run, before OpenBao is initialized.
for var in ["OPENBAO_LOG_LEVEL", "OPENBAO_AUDIT_LOG", "OPENBAO_UNSEAL_MODE"]:
    agent.set_env(var, openbao.DEFAULTS[var])
