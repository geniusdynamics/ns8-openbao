#
# Role secretsclient: record an access request of the calling module (or
# ask for more for an approved one). The administrator approves it in the
# OpenBao UI; the request itself grants nothing.
#

import json
import sys
import openbao_clients as clients

data = json.load(sys.stdin)
try:
    module_id = clients.caller_module()
    output = clients.request_access(module_id, bool(data.get("database_engine", False)),
                                    data.get("groups", []))
except clients.ClientError as ex:
    clients.report(ex)
json.dump(output, fp=sys.stdout)
