import os
import sys
import agent
import openbao

env = openbao.read_environment()

if not env.get("TRAEFIK_HOST"):
    print("The original instance was never configured: skipping configure-module", file=sys.stderr)
    sys.exit(0)

# Let's Encrypt is not requested here: the host name might not resolve to
# this node yet. It can be enabled again from the Settings page.
request = {
    "host": env["TRAEFIK_HOST"],
    "http2https": openbao.is_true(env["TRAEFIK_HTTP2HTTPS"]),
    "log_level": env["OPENBAO_LOG_LEVEL"],
    "audit_log": openbao.is_true(env["OPENBAO_AUDIT_LOG"]),
    "unseal_mode": env["OPENBAO_UNSEAL_MODE"],
    "notify_recipients": openbao.notify_recipients(env),
    "ip_allowlist": openbao.ip_allowlist(env),
    "starter_kits": openbao.starter_kits(env),
    "vpn_api": openbao.vpn_api_enabled(env),
    "public_access": openbao.public_access(env),
    "snapshot_keep": openbao.snapshot_keep(env),
    "transit_address": env["OPENBAO_TRANSIT_ADDRESS"],
    "transit_mount": env["OPENBAO_TRANSIT_MOUNT"],
    "transit_key": env["OPENBAO_TRANSIT_KEY"],
    "transit_tls_skip_verify": openbao.is_true(env["OPENBAO_TRANSIT_TLS_SKIP_VERIFY"]),
    "ldap_group_policies": [],
    "user_domain": "",
    "ldap_admin_group": "",
}

# The user domain might not exist in this cluster: keep directory login
# only if it does. OpenBao keeps its own LDAP settings anyway.
domain = env["OPENBAO_USER_DOMAIN"]
if domain and domain in [d["name"] for d in openbao.list_user_domains()]:
    request["user_domain"] = domain
    request["ldap_admin_group"] = env["OPENBAO_LDAP_ADMIN_GROUP"]
    request["ldap_group_policies"] = openbao.ldap_group_policies(env)
elif domain:
    print(f"<4>User domain {domain} is not available: directory login binding dropped", file=sys.stderr)

configure_retval = agent.tasks.run(agent_id=os.environ["AGENT_ID"], action="configure-module", data=request)
if configure_retval["exit_code"] != 0 and request["user_domain"]:
    # For example the administrators group does not exist in this cluster
    print("<4>configure-module failed with directory login: retrying without it", file=sys.stderr)
    request["user_domain"] = ""
    request["ldap_admin_group"] = ""
    request["ldap_group_policies"] = []
    configure_retval = agent.tasks.run(agent_id=os.environ["AGENT_ID"], action="configure-module", data=request)
agent.assert_exp(configure_retval["exit_code"] == 0, "The configure-module subtask failed!")
