import json
import sys
import agent
import openbao

request = json.load(sys.stdin)
original_environment = request["environment"]

# Backups of older module releases may lack some variables: use defaults
for evar in [
        "TRAEFIK_HOST",
        "TRAEFIK_HTTP2HTTPS",
        "OPENBAO_LOG_LEVEL",
        "OPENBAO_AUDIT_LOG",
        "OPENBAO_UNSEAL_MODE",
        "OPENBAO_USER_DOMAIN",
        "OPENBAO_LDAP_ADMIN_GROUP",
        "OPENBAO_NOTIFY_RECIPIENTS",
        "OPENBAO_IP_ALLOWLIST",
        "OPENBAO_LDAP_GROUP_POLICIES",
        "OPENBAO_STARTER_KITS",
        "OPENBAO_VPN_API",
        "OPENBAO_TRANSIT_ADDRESS",
        "OPENBAO_TRANSIT_MOUNT",
        "OPENBAO_TRANSIT_KEY",
        "OPENBAO_TRANSIT_TLS_SKIP_VERIFY",
        "OPENBAO_PUBLIC_ACCESS",
        "OPENBAO_SNAPSHOT_KEEP",
        "OPENBAO_PLUGINS",
        # Stored in the Raft data: it must not change
        "OPENBAO_RAFT_NODE_ID",
    ]:
    value = original_environment.get(evar, openbao.DEFAULTS.get(evar))
    if value is not None:
        agent.set_env(evar, value)

# The high availability role is not restored: the instance comes back as a
# standalone, single-node OpenBao. Data of an HA instance still lists the
# other Raft peers, which would leave it without a quorum: rewrite its Raft
# configuration as a single node before the first start.
if original_environment.get("OPENBAO_HA_ROLE", "standalone") in ("primary", "member"):
    agent.set_env("OPENBAO_RAFT_RECOVER", "True")
