import json
import sys
import agent
import openbao

request = json.load(sys.stdin)
original_environment = request["environment"]

# Backups of older module releases may lack some variables: use defaults
for evar in [
        "TRAEFIK_HOST",
        "TRAEFIK_HTTP2HTTPS",
        "OPENBAO_LOG_LEVEL",
        "OPENBAO_AUDIT_LOG",
        "OPENBAO_UNSEAL_MODE",
        "OPENBAO_USER_DOMAIN",
        "OPENBAO_LDAP_ADMIN_GROUP",
        "OPENBAO_NOTIFY_RECIPIENTS",
    ]:
    value = original_environment.get(evar, openbao.DEFAULTS.get(evar))
    if value is not None:
        agent.set_env(evar, value)
