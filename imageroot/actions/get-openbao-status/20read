#
# Return the OpenBao server state. Only the unauthenticated seal-status
# endpoint is used: no token or key is handled by the module.
#

import json
import sys
import openbao

env = openbao.read_environment()
host = env.get("TRAEFIK_HOST", "")
active = openbao.service_is_active()
status = openbao.get_seal_status() if active else None

ui_url = f"https://{host}/ui/" if host else ""
if host and not openbao.public_access(env):
    vpn = openbao.vpn_api_endpoint(env)
    ui_url = "http://{}:{}/ui/".format(*vpn) if vpn else ""



def ha_status():
    role = openbao.ha_role(env)
    info = {
        "role": role,
        "cluster": env["OPENBAO_HA_CLUSTER"],
        "node_id": openbao.raft_node_id(env),
        "raft_address": openbao.raft_address(env),
        "is_self": None,
        "leader_address": "",
        "peers": None,
    }
    if role == "standalone" or not status or status.get("sealed"):
        return info
    leader = openbao.ha_leader_status() or {}
    info["is_self"] = leader.get("is_self")
    info["leader_address"] = leader.get("leader_address", "")
    # Needs the module token, which members do not have
    info["peers"] = openbao.raft_peers()
    return info


result = {
    "service_active": active,
    "reachable": status is not None,
    "initialized": bool(status and status.get("initialized")),
    "sealed": bool(status.get("sealed", True)) if status else True,
    "seal_type": status.get("type", "") if status else "",
    "version": status.get("version", "") if status else "",
    "threshold": int(status.get("t", 0)) if status else 0,
    "shares": int(status.get("n", 0)) if status else 0,
    "progress": int(status.get("progress", 0)) if status else 0,
    "unseal_mode": env["OPENBAO_UNSEAL_MODE"],
    "user_domain": env["OPENBAO_USER_DOMAIN"],
    # Needs the module token (openbao-module-token); never returns tokens
    "module_token": openbao.module_token_status() if status else "unknown",
    "root_token_present": openbao.root_token_present()
    if status and status.get("initialized") and not status.get("sealed") else None,
    "ui_url": ui_url,
    "seal_migration_from": env["OPENBAO_SEAL_MIGRATION_FROM"],
    "migration": bool(status and status.get("migration")),
    "ha": ha_status(),
    # Optional plugins installed from the catalog (the Plugins page)
    "plugins": sorted(pid for pid in openbao.declared_plugins()
                      if openbao.catalog_entry(pid)),
}

json.dump(result, fp=sys.stdout)
