{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "send-test-email input",
    "$id": "http://schema.nethserver.org/openbao/send-test-email-input.json",
    "description": "Send a test email through the cluster SMTP smarthost, to verify the notification settings",
    "examples": [
        {},
        {
            "recipients": ["security@example.org"]
        }
    ],
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "recipients": {
            "type": "array",
            "description": "Recipients of the test email. Defaults to the configured notification recipients",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {"type": "string", "format": "email", "pattern": "^[^@\\s,]+@[^@\\s,]+$"}
        }
    }
}
