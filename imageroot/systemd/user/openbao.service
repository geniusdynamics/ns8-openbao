#
# OpenBao server with Raft integrated storage. The API and web UI are
# published on the host loopback interface only: Traefik exposes them on
# the configured host name with TLS. The container reaches the node
# ldapproxy for directory login at 10.0.2.2 (host loopback). The
# Prometheus metrics listener is published on the node cluster VPN
# address, for the NS8 metrics module.
#
[Unit]
Description=OpenBao secrets manager

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
# Written by openbao-write-config (ExecStartPre): systemd reads it again
# before ExecStart
EnvironmentFile=-%E/state/openbao-runtime.env
WorkingDirectory=%E/state
Restart=always
TimeoutStartSec=120
ExecStartPre=/bin/rm -f %t/openbao.pid %t/openbao.ctr-id
ExecStartPre=-runagent openbao-install-plugins
ExecStartPre=runagent openbao-write-config
ExecStart=/usr/bin/podman run \
    --detach \
    --conmon-pidfile=%t/openbao.pid \
    --cidfile=%t/openbao.ctr-id \
    --cgroups=no-conmon \
    --replace --name=%N \
    --cap-drop=all \
    --security-opt=no-new-privileges \
    --network=slirp4netns:allow_host_loopback=true \
    --publish=127.0.0.1:${TCP_PORT}:8200 \
    $OPENBAO_PUBLISH_METRICS \
    $OPENBAO_PUBLISH_VPN_API \
    --volume=openbao-data:/openbao/file:Z \
    --volume=%E/state/openbao-config:/openbao/config:ro,Z \
    --volume=%E/state/openbao-plugins:/openbao/plugins:ro,Z \
    --env-file=%E/state/openbao-container.env \
    ${OPENBAO_IMAGE} server
ExecStartPost=-runagent openbao-wait-ready 90
ExecReload=/usr/bin/podman kill --signal=HUP --cidfile=%t/openbao.ctr-id
ExecStop=/usr/bin/podman stop --ignore --cidfile=%t/openbao.ctr-id -t 30
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile=%t/openbao.ctr-id
PIDFile=%t/openbao.pid
Type=forking

[Install]
WantedBy=default.target
